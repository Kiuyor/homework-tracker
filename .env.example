# ============================================
# 环境变量说明
# ============================================
# ⚠️ 本项目【不】自动加载 .env 文件：代码里没有任何 dotenv 之类的加载器。
#    下面这些变量写成什么都不改行为，必须以「系统环境变量」的方式设置，
#    或在启动前手动 set / export。例如：
#
#      Windows cmd        :  set PORT=8080 && node server.js
#      Windows PowerShell :  $env:PORT = "8080"; node server.js
#      Linux / macOS      :  PORT=8080 node server.js
#
#    绿色版用户请看 README.txt（改 start.bat 加 set 行），无需读本文件。

# SQLite 数据库文件路径（可选，默认项目根目录 homework.db）
# DB_PATH=./data/homework.db

# 服务器端口（可选，默认 3000）
# PORT=3000

# CORS 允许的来源（可选，生产环境建议设置具体域名）
# CORS_ORIGIN=https://your-domain.com
